.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.lnk
desktop.ini

# Linux
*~

# ============================================
# LOGS & TEMP FILES
# ============================================
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# ============================================
# MISC
# ============================================
# User-specific files
.user.yml
*.local

# Test outputs
test-results/
test-output/

# Package manager locks (keep yarn.lock, remove others if using yarn)
# package-lock.json  # Uncomment if using yarn exclusively

